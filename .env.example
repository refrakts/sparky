# All env vars are declared and validated in src/env.ts.
# Anything missing here is read via process.env directly (e.g. NODE_ENV).

# ─── Site ─────────────────────────────────────────────────────────────
# Canonical site URL. Used for SEO metadata, sitemap, robots.txt.
NEXT_PUBLIC_SITE_URL=https://sparky-eta.vercel.app

# ─── AI (Vercel AI Gateway) ───────────────────────────────────────────
# On Vercel: authentication is automatic via OIDC (no key needed).
# For local dev: create a key at https://vercel.com/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=...

# Optional per-role model overrides. Any model the AI Gateway accepts
# works (e.g. cohere/command-a, openai/gpt-5, openai/gpt-4o-mini,
# mistral/mistral-large-latest, google/gemini-2.5-flash).
# Defaults: orchestrator=cohere/command-a, worker=google/gemini-2.5-flash-lite.
# MODEL_ORCHESTRATOR=cohere/command-a
# MODEL_WORKER=google/gemini-2.5-flash-lite

# Reasoning effort for the worker subagent. Only applies to OpenAI reasoning
# models (o-series, gpt-5). Higher = better quality, more tokens, more latency.
# WORKER_REASONING_EFFORT=high

# ─── Firecrawl (web research subagent tools) ──────────────────────────
# Sign up at https://firecrawl.dev to get a key. Without it, search/scrape/map
# tools error at call time but the rest of the app works.
# FIRECRAWL_API_KEY=fc-...

# ─── PostHog (analytics + AI tracing) ─────────────────────────────────
# Project token from posthog.com → Project Settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Upstream APIs (optional — defaults baked in) ─────────────────────
# SPARKSCAN_API_URL=https://api.sparkscan.io
# FLASHNET_API_URL=https://api.flashnet.xyz

# ─── Dev toggles ──────────────────────────────────────────────────────
# Set to "true" to enable @tanstack/react-table debug logging.
# NEXT_PUBLIC_TABLE_DEBUG=false
